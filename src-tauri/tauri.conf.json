{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel",
  "version": "0.1.0",
  "identifier": "dev.kestrel.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kestrel",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "msi", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Open-source agent workbench",
    "longDescription": "Kestrel is an open-source, Linux-first agent workbench. It runs a tool-using AI agent against your local machine with an explicit approval gate for every mutating action.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
